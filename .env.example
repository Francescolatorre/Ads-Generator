# Server-only. Never prefix these with VITE_. Never commit real keys.
REPLICATE_API_TOKEN=
RUNWARE_API_KEY=
# Default locked; enable only after budget approval, then restart npm run dev.
ALLOW_PAID_DECOMPOSITION=false
# Existing prototype generation flow (unrelated to decomposition)
GEMINI_API_KEY=
# Server-to-server only. Requires access to your Process Flow instance (e.g. Tailscale).
PROCESS_FLOW_URL=
PROCESS_FLOW_API_TOKEN=
# Optional separate asset-review instance; defaults to PROCESS_FLOW_URL.
PROCESS_FLOW_ASSET_URL=

# Separate token when an alternate asset instance is configured.
PROCESS_FLOW_ASSET_TOKEN=
